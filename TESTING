    .impact-card .impact-icon { width: 35px; height: 35px; display: grid; place-items: center; margin-bottom: 13px; border-radius: 12px; color: var(--cyan); background: rgba(99,230,210,.08); font-size: 11px; font-weight: 850; }
    .impact-card:nth-child(2) .impact-icon { color: var(--coral); background: rgba(255,138,108,.08); }
    .impact-card:nth-child(3) .impact-icon { color: var(--yellow); background: rgba(255,209,102,.08); }
    .impact-card:nth-child(4) .impact-icon { color: var(--green); background: rgba(139,213,154,.08); }
    .impact-card h3 { margin: 0 0 7px; font-size: 13px; }
