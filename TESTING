      border-radius: 999px;
      background: rgba(185,219,220,.22);
      cursor: pointer;
      transition: .25s var(--ease);
    }
    .rail button::before { content: ""; position: absolute; inset: -5px; }
    .rail button:hover { background: rgba(99,230,210,.55); }
    .rail button.is-active { height: 25px; background: var(--cyan); box-shadow: 0 0 18px rgba(99,230,210,.35); }
    .rail button span {
      position: absolute;
      right: 18px;
