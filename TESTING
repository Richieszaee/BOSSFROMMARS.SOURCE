<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#071c2b" />
  <meta name="description" content="Presentasi interaktif geografi tentang hidrosfer dan fenomena banjir perkotaan di Bekasi." />
  <title>Ketika Air Kehilangan Ruang — Hidrosfer & Banjir</title>
  <style>
    :root {
      --ink: #ecf8f8;
      --muted: #9db9bc;
      --muted-2: #6f9197;
      --deep: #061722;
      --deep-2: #092431;
      --panel: rgba(12, 44, 55, .76);
      --panel-strong: #0e3542;
      --line: rgba(182, 226, 222, .15);
      --cyan: #63e6d2;
      --cyan-2: #21bdb1;
      --blue: #4fa8ff;
      --coral: #ff8a6c;
      --yellow: #ffd166;
      --green: #8bd59a;
      --purple: #bda0ff;
      --shadow: 0 24px 80px rgba(0, 0, 0, .3);
      --radius: 24px;
      --ease: cubic-bezier(.2, .75, .2, 1);
      --topbar: 72px;
      --bottombar: 70px;
    }

    * { box-sizing: border-box; }
    html, body { width: 100%; height: 100%; margin: 0; overflow: hidden; }
    body {
      color: var(--ink);
      background:
        radial-gradient(circle at 12% 12%, rgba(31, 181, 169, .13), transparent 30%),
        radial-gradient(circle at 88% 88%, rgba(79, 168, 255, .10), transparent 32%),
        var(--deep);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    button, input, a { font: inherit; }
    button { color: inherit; }
    a { color: var(--cyan); }
    ::selection { color: #042027; background: var(--cyan); }

    .app {
      position: relative;
      width: 100%;
      height: 100%;
      isolation: isolate;
    }

    .ambient {
      position: fixed;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
      z-index: -1;
    }
    .ambient::before,
    .ambient::after {
      content: "";
      position: absolute;
      width: 460px;
      height: 460px;
      border: 1px solid rgba(99, 230, 210, .09);
      border-radius: 50%;
      animation: drift 17s ease-in-out infinite alternate;
    }
    .ambient::before { left: -260px; top: 10%; }
    .ambient::after { right: -280px; bottom: -80px; animation-delay: -7s; }
    .grid-noise {
      position: absolute;
      inset: 0;
      opacity: .2;
      background-image:
        linear-gradient(rgba(255,255,255,.018) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,.018) 1px, transparent 1px);
      background-size: 48px 48px;
      mask-image: linear-gradient(to bottom, transparent, black 16%, black 84%, transparent);
    }

    .topbar {
      position: fixed;
      z-index: 30;
      inset: 0 0 auto 0;
      height: var(--topbar);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      padding: 0 clamp(18px, 3vw, 44px);
      border-bottom: 1px solid var(--line);
      background: linear-gradient(to bottom, rgba(6, 23, 34, .94), rgba(6, 23, 34, .72));
      backdrop-filter: blur(16px);
    }

    .brand {
      min-width: 0;
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .brand-mark {
      width: 39px;
      height: 39px;
      flex: 0 0 auto;
      border-radius: 13px;
      display: grid;
      place-items: center;
      color: #06232a;
      background: linear-gradient(135deg, var(--cyan), #79bfff);
      box-shadow: 0 8px 28px rgba(66, 217, 203, .16);
    }
    .brand-mark svg { width: 24px; height: 24px; }
    .brand-copy { min-width: 0; }
    .brand-title {
      margin: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      font-size: 13px;
      font-weight: 760;
      letter-spacing: .03em;
    }
    .brand-sub {
      margin-top: 2px;
      color: var(--muted-2);
      font-size: 10px;
      letter-spacing: .14em;
      text-transform: uppercase;
    }

    .top-actions { display: flex; align-items: center; gap: 8px; }
    .slide-count {
      display: flex;
      align-items: baseline;
      gap: 4px;
      margin-right: 8px;
      color: var(--muted);
      font-variant-numeric: tabular-nums;
    }
    .slide-count strong { color: var(--ink); font-size: 17px; }
    .slide-count span { font-size: 11px; }

    .icon-btn,
    .nav-btn,
    .primary-btn,
    .ghost-btn,
    .preset-btn,
    .mode-btn {
      border: 0;
      cursor: pointer;
      transition: transform .2s var(--ease), background .2s, border-color .2s, color .2s, opacity .2s;
    }
    .icon-btn {
      position: relative;
      width: 39px;
      height: 39px;
      display: grid;
      place-items: center;
      border: 1px solid var(--line);
      border-radius: 12px;
      color: var(--muted);
      background: rgba(255,255,255,.035);
    }
    .icon-btn svg { width: 18px; height: 18px; }
    .icon-btn:hover { color: var(--ink); border-color: rgba(99,230,210,.35); background: rgba(99,230,210,.08); }
    .icon-btn:active, .nav-btn:active, .primary-btn:active, .ghost-btn:active { transform: scale(.96); }
    .icon-btn.is-active { color: var(--cyan); border-color: rgba(99,230,210,.36); background: rgba(99,230,210,.1); }
    .icon-btn .tip {
      position: absolute;
      top: calc(100% + 9px);
      right: 0;
      width: max-content;
      padding: 7px 9px;
      border: 1px solid var(--line);
      border-radius: 8px;
      color: var(--ink);
      background: #0d303c;
      font-size: 10px;
      opacity: 0;
      transform: translateY(-4px);
      pointer-events: none;
      transition: .2s;
      box-shadow: var(--shadow);
    }
    .icon-btn:hover .tip { opacity: 1; transform: none; }

    .deck {
      position: fixed;
      inset: var(--topbar) 0 var(--bottombar);
      overflow: hidden;
    }
    .slide {
      position: absolute;
      inset: 0;
      display: block;
      overflow: auto;
      overscroll-behavior: contain;
      padding: clamp(28px, 4.2vh, 52px) clamp(52px, 6vw, 92px);
      opacity: 0;
      transform: translateX(5.5%) scale(.985);
      visibility: hidden;
      pointer-events: none;
      transition:
        opacity .55s var(--ease),
        transform .65s var(--ease),
        visibility 0s linear .65s;
    }
    .slide.is-before { transform: translateX(-5.5%) scale(.985); }
    .slide.is-active {
      opacity: 1;
      transform: translateX(0) scale(1);
      visibility: visible;
      pointer-events: auto;
      transition-delay: 0s;
    }
    .slide-inner {
      width: min(1180px, 100%);
      min-height: 100%;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .reveal { opacity: 0; transform: translateY(18px); }
    .is-active .reveal {
      animation: reveal .68s var(--ease) forwards;
      animation-delay: calc(var(--d, 0) * 90ms + 90ms);
    }

    .eyebrow,
    .kicker {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      width: fit-content;
      color: var(--cyan);
      font-size: 11px;
      font-weight: 760;
      letter-spacing: .16em;
      text-transform: uppercase;
    }
    .eyebrow::before,
    .kicker::before {
      content: "";
      width: 24px;
      height: 1px;
      background: currentColor;
    }

    h1, h2, h3, p { margin-top: 0; }
    h1 {
      max-width: 780px;
      margin: 18px 0 20px;
      font-size: clamp(46px, 6.5vw, 88px);
      line-height: .96;
      letter-spacing: -.055em;
      font-weight: 810;
    }
    h1 .soft { color: #8ab0b5; }
    h1 .water-word {
      color: transparent;
      background: linear-gradient(110deg, var(--cyan), #88bfff 70%);
      background-clip: text;
      -webkit-background-clip: text;
    }
    h2 {
      margin: 10px 0 14px;
      font-size: clamp(30px, 4vw, 54px);
      line-height: 1.03;
      letter-spacing: -.04em;
      font-weight: 790;
    }
    h3 { font-size: 16px; line-height: 1.25; }
    p { color: var(--muted); line-height: 1.65; }
    .lead { max-width: 760px; font-size: clamp(15px, 1.45vw, 19px); }
    .accent { color: var(--cyan); }
    .coral { color: var(--coral); }
    .yellow { color: var(--yellow); }

    .section-head {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 28px;
      margin-bottom: clamp(22px, 3.5vh, 38px);
    }
    .section-head > div:first-child { max-width: 840px; }
    .section-head p { max-width: 370px; margin-bottom: 4px; font-size: 13px; }
    .chapter-no {
      flex: 0 0 auto;
      color: rgba(163, 206, 208, .19);
      font-size: clamp(48px, 7vw, 90px);
      font-weight: 850;
      line-height: .8;
      letter-spacing: -.07em;
    }

    .card {
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: linear-gradient(145deg, rgba(17,58,69,.74), rgba(8,35,45,.72));
      box-shadow: 0 18px 45px rgba(0,0,0,.13);
    }

    /* Cover */
    .cover .slide-inner { justify-content: center; }
    .cover-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.12fr) minmax(360px, .88fr);
      align-items: center;
      gap: clamp(30px, 6vw, 82px);
    }
    .cover-copy .lead { max-width: 650px; }
    .cover-actions { display: flex; flex-wrap: wrap; gap: 11px; margin-top: 28px; }
    .primary-btn,
    .ghost-btn {
      min-height: 46px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 0 17px;
      border-radius: 13px;
      font-weight: 740;
      font-size: 13px;
    }
    .primary-btn {
      color: #03272a;
      background: linear-gradient(120deg, var(--cyan), #8dd8ff);
      box-shadow: 0 12px 34px rgba(67, 220, 207, .2);
    }
    .primary-btn:hover { transform: translateY(-2px); box-shadow: 0 16px 38px rgba(67, 220, 207, .27); }
    .ghost-btn {
      border: 1px solid var(--line);
      color: var(--ink);
      background: rgba(255,255,255,.035);
    }
    .ghost-btn:hover { transform: translateY(-2px); background: rgba(255,255,255,.07); }
    .primary-btn svg, .ghost-btn svg { width: 17px; height: 17px; }

    .meta-row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 23px; }
    .meta-pill {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 7px 10px;
      border: 1px solid var(--line);
      border-radius: 999px;
      color: var(--muted);
      background: rgba(255,255,255,.025);
      font-size: 10px;
      letter-spacing: .04em;
    }
    .meta-pill i { width: 6px; height: 6px; border-radius: 50%; background: var(--cyan); box-shadow: 0 0 12px var(--cyan); }

    .storm-card {
      position: relative;
      min-height: 440px;
      overflow: hidden;
      border: 1px solid rgba(131, 216, 216, .2);
      border-radius: 34px;
      background:
        radial-gradient(circle at 60% 18%, rgba(104, 212, 204, .13), transparent 31%),
        linear-gradient(160deg, #123e4b, #071f2b 70%);
      box-shadow: var(--shadow);
    }
    .storm-card::before {
      content: "";
      position: absolute;
      inset: 16px;
      border: 1px solid rgba(255,255,255,.055);
      border-radius: 25px;
      pointer-events: none;
    }
    .storm-label {
      position: absolute;
      z-index: 3;
      left: 27px;
      top: 25px;
      display: flex;
      align-items: center;
      gap: 8px;
      color: #bce0df;
      font-size: 10px;
      font-weight: 720;
      letter-spacing: .12em;
      text-transform: uppercase;
    }
    .storm-label::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--coral); animation: pulse 1.8s infinite; }
    .storm-card svg { position: absolute; inset: 40px 0 0; width: 100%; height: calc(100% - 40px); }
    .rain-line { stroke-dasharray: 12 18; animation: rainStroke 1.15s linear infinite; }
    .rain-line:nth-child(2n) { animation-duration: .9s; animation-delay: -.4s; }
    .rain-line:nth-child(3n) { animation-duration: 1.35s; animation-delay: -.75s; }
    .cloud-float { animation: cloudFloat 6s ease-in-out infinite alternate; transform-origin: center; }
    .water-wave { animation: waveMove 5s ease-in-out infinite alternate; transform-origin: center; }
    .storm-caption {
      position: absolute;
      z-index: 3;
      left: 27px;
      right: 27px;
      bottom: 25px;
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 16px;
    }
    .storm-caption strong { display: block; max-width: 240px; font-size: 19px; letter-spacing: -.02em; }
    .storm-caption small { color: #8fb1b5; font-size: 10px; }
    .storm-stat {
      min-width: 76px;
      padding: 11px 12px;
      border: 1px solid rgba(255,255,255,.11);
      border-radius: 14px;
      text-align: center;
      background: rgba(4,28,37,.55);
      backdrop-filter: blur(10px);
    }
    .storm-stat b { display: block; color: var(--cyan); font-size: 20px; }

    /* Story */
    .story-grid {
      display: grid;
      grid-template-columns: .92fr 1.08fr;
      gap: 20px;
      align-items: stretch;
    }
    .narrative-card { padding: clamp(23px, 3vw, 34px); }
    .quote-mark { color: var(--cyan); font-family: Georgia, serif; font-size: 56px; line-height: .65; opacity: .65; }
    .narrative-card blockquote { margin: 17px 0 24px; font-size: clamp(18px, 2vw, 26px); font-weight: 650; line-height: 1.35; letter-spacing: -.025em; }
    .narrative-card blockquote em { color: var(--cyan); font-style: normal; }
    .core-idea {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      padding-top: 18px;
      border-top: 1px solid var(--line);
    }
    .core-idea .mini-icon { flex: 0 0 auto; }
    .core-idea p { margin: 0; font-size: 12px; }
    .mini-icon {
      width: 35px;
      height: 35px;
      display: grid;
      place-items: center;
      border-radius: 11px;
      color: var(--cyan);
      background: rgba(99,230,210,.09);
      font-weight: 800;
    }

    .scene-sequence {
      position: relative;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
    .scene-step {
      position: relative;
      overflow: hidden;
      min-height: 150px;
      padding: 20px;
      border: 1px solid var(--line);
      border-radius: 21px;
      background: rgba(12,46,57,.58);
    }
    .scene-step::after {
      content: attr(data-step);
      position: absolute;
      top: 7px;
      right: 13px;
      color: rgba(255,255,255,.08);
      font-size: 42px;
      font-weight: 850;
    }
    .scene-step .step-icon {
      width: 38px;
      height: 38px;
      display: grid;
      place-items: center;
      margin-bottom: 18px;
      border: 1px solid rgba(255,255,255,.08);
      border-radius: 12px;
      color: var(--cyan);
      background: rgba(255,255,255,.04);
    }
    .scene-step .step-icon svg { width: 21px; height: 21px; }
    .scene-step h3 { margin-bottom: 6px; }
    .scene-step p { margin: 0; font-size: 11px; line-height: 1.5; }
    .scene-step:nth-child(3) .step-icon { color: var(--yellow); }
    .scene-step:nth-child(4) .step-icon { color: var(--coral); }

    /* Objects */
    .object-layout {
      display: grid;
      grid-template-columns: 1.06fr .94fr;
      gap: 20px;
      align-items: stretch;
    }
    .primary-object {
      position: relative;
      overflow: hidden;
      min-height: 345px;
      padding: clamp(26px, 3vw, 38px);
    }
    .primary-object::after {
      content: "H₂O";
      position: absolute;
      right: -18px;
      bottom: -42px;
      color: rgba(105, 229, 212, .055);
      font-size: 150px;
      font-weight: 850;
      letter-spacing: -.08em;
    }
    .object-badge { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    .object-badge span {
      padding: 6px 9px;
      border-radius: 999px;
      color: #04272a;
      background: var(--cyan);
      font-size: 9px;
      font-weight: 850;
      letter-spacing: .12em;
      text-transform: uppercase;
    }
    .object-badge small { color: var(--muted-2); font-size: 10px; }
    .primary-object h3 { margin: 30px 0 10px; font-size: clamp(34px, 4vw, 55px); letter-spacing: -.05em; }
    .primary-object > p { max-width: 500px; font-size: 14px; }
    .object-why {
      position: relative;
      z-index: 2;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
      margin-top: 25px;
    }
    .object-why div { padding: 13px; border-radius: 14px; background: rgba(3,23,31,.47); }
    .object-why b { display: block; margin-bottom: 5px; color: var(--cyan); font-size: 11px; }
    .object-why small { color: var(--muted); font-size: 9px; line-height: 1.4; }

    .support-stack { display: grid; gap: 11px; }
    .support-card {
      display: grid;
      grid-template-columns: 42px 1fr auto;
      align-items: center;
      gap: 13px;
      padding: 15px 17px;
      border: 1px solid var(--line);
      border-radius: 17px;
      background: rgba(13,49,60,.59);
    }
    .support-card .orb {
      width: 42px;
      height: 42px;
      display: grid;
      place-items: center;
      border-radius: 14px;
      color: var(--blue);
      background: rgba(79,168,255,.1);
      font-weight: 850;
      font-size: 14px;
    }
    .support-card:nth-child(2) .orb { color: var(--yellow); background: rgba(255,209,102,.09); }
    .support-card:nth-child(3) .orb { color: var(--green); background: rgba(139,213,154,.1); }
    .support-card:nth-child(4) .orb { color: var(--coral); background: rgba(255,138,108,.09); }
    .support-card h3 { margin: 0 0 3px; font-size: 13px; }
    .support-card p { margin: 0; font-size: 10px; line-height: 1.35; }
    .support-card > small { color: var(--muted-2); font-size: 9px; text-transform: uppercase; }
    .formal-note {
      grid-column: 1 / -1;
      display: flex;
      align-items: center;
      gap: 13px;
      margin-top: 0;
      padding: 13px 17px;
      border: 1px dashed rgba(99,230,210,.24);
      border-radius: 16px;
      color: var(--muted);
      background: rgba(99,230,210,.035);
      font-size: 11px;
      line-height: 1.5;
    }
    .formal-note b { color: var(--ink); }

    /* Cycle */
    .cycle-layout {
      display: grid;
      grid-template-columns: 1.14fr .86fr;
      gap: 20px;
      align-items: stretch;
    }
    .cycle-card { position: relative; overflow: hidden; min-height: 375px; padding: 20px; }
    .cycle-card svg { width: 100%; height: 335px; display: block; }
    .flow-path { stroke-dasharray: 8 10; animation: flowDash 2s linear infinite; }
    .cycle-legend {
      position: absolute;
      left: 21px;
      bottom: 17px;
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }
    .cycle-legend span {
      padding: 6px 8px;
      border: 1px solid var(--line);
      border-radius: 999px;
      color: var(--muted);
      background: rgba(3,24,32,.62);
      font-size: 9px;
    }
    .balance-stack { display: grid; gap: 12px; }
    .balance-card { padding: 20px; }
    .balance-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    .balance-head h3 { margin: 0; }
    .status-tag { padding: 5px 8px; border-radius: 999px; color: var(--green); background: rgba(139,213,154,.09); font-size: 9px; font-weight: 800; }
    .status-tag.warn { color: var(--coral); background: rgba(255,138,108,.09); }
    .balance-card p { margin: 10px 0 15px; font-size: 10px; line-height: 1.5; }
    .metric { display: grid; grid-template-columns: 76px 1fr 64px; align-items: center; gap: 9px; margin-top: 9px; }
    .metric > span { color: var(--muted); font-size: 9px; }
    .metric > em { color: var(--muted-2); font-size: 8px; font-style: normal; text-align: right; }
    .bar { height: 7px; overflow: hidden; border-radius: 99px; background: rgba(255,255,255,.06); }
    .bar i { display: block; width: var(--w); height: 100%; border-radius: inherit; background: var(--green); transform-origin: left; }
    .is-active .bar i { animation: growBar .9s var(--ease) both; animation-delay: .45s; }
    .balance-card.urban .bar i { background: var(--coral); }
    .balance-card.urban .metric:nth-of-type(3) .bar i { background: var(--yellow); }

    /* Analysis */
    .equation-card {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, .8fr);
      align-items: center;
      gap: 13px;
      padding: clamp(18px, 2.5vw, 28px);
      margin-bottom: 16px;
    }
    .eq-block { padding: 16px; border-radius: 17px; background: rgba(255,255,255,.035); }
    .eq-block small { display: block; color: var(--muted-2); font-size: 9px; letter-spacing: .1em; text-transform: uppercase; }
    .eq-block strong { display: block; margin: 5px 0; font-size: clamp(16px, 1.9vw, 23px); }
    .eq-block span { color: var(--muted); font-size: 9px; }
    .eq-symbol { color: var(--muted-2); font-size: 27px; font-weight: 300; }
    .eq-block.inflow strong { color: var(--blue); }
    .eq-block.capacity strong { color: var(--green); }
    .eq-block.result { border: 1px solid rgba(255,138,108,.18); background: rgba(255,138,108,.055); }
    .eq-block.result strong { color: var(--coral); }

