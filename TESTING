    }
    .concept-card:hover, .concept-card.is-highlighted { transform: translateY(-4px); border-color: rgba(99,230,210,.34); background: rgba(16,58,68,.76); }
    .concept-index { display: flex; align-items: center; justify-content: space-between; margin-bottom: 11px; color: var(--muted-2); font-size: 8px; }
