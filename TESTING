    .capacity-note { display: flex; align-items: center; gap: 10px; grid-column: 1 / -1; padding: 12px 15px; border: 1px dashed rgba(139,213,154,.24); border-radius: 15px; color: var(--muted); font-size: 9px; }
    .capacity-note b { color: var(--green); }

    /* Solutions */
    .solution-thesis { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 16px; padding: 16px 19px; border: 1px solid rgba(99,230,210,.18); border-radius: 18px; background: linear-gradient(90deg, rgba(99,230,210,.07), transparent); }
