    .method-note { display: grid; grid-template-columns: auto 1fr; gap: 13px; align-items: start; margin-top: 13px; padding: 15px 17px; border: 1px dashed rgba(255,209,102,.22); border-radius: 16px; background: rgba(255,209,102,.035); }
    .method-note b { color: var(--yellow); font-size: 10px; }
    .method-note p { margin: 0; font-size: 8.5px; line-height: 1.5; }

    /* Navigation */
    .rail {
      position: fixed;
      z-index: 35;
      right: 17px;
      top: 50%;
