    .scale-chip b { display: block; margin-bottom: 3px; color: var(--ink); font-size: 9px; }
    .scale-chip span { color: var(--muted); font-size: 7.5px; }

    /* Closing */
    .closing-grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: 20px; align-items: stretch; }
    .thesis-card { position: relative; overflow: hidden; padding: clamp(25px, 3.6vw, 42px); }
    .thesis-card::after { content: "∿"; position: absolute; right: -17px; bottom: -70px; color: rgba(99,230,210,.055); font-size: 220px; font-weight: 300; }
    .thesis-card small { color: var(--cyan); font-size: 9px; font-weight: 800; letter-spacing: .15em; text-transform: uppercase; }
    .thesis-card blockquote { position: relative; z-index: 1; margin: 20px 0 25px; font-size: clamp(22px, 3vw, 36px); font-weight: 700; line-height: 1.25; letter-spacing: -.04em; }
    .thesis-card blockquote em { color: var(--cyan); font-style: normal; }
    .memory-list { position: relative; z-index: 1; display: grid; gap: 9px; }
    .memory-item { display: grid; grid-template-columns: 26px 1fr; gap: 10px; align-items: start; color: var(--muted); font-size: 10px; line-height: 1.45; }
