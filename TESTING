    .drain { position: absolute; right: 13%; bottom: 17.5%; width: 63px; height: 18px; border: 3px solid #28434a; border-radius: 5px; background: repeating-linear-gradient(90deg, #5a777b 0 3px, transparent 3px 8px); z-index: 5; }
    .water-layer { position: absolute; z-index: 4; left: 0; right: 0; bottom: 0; height: var(--water-h, 31%); min-height: 12%; background: linear-gradient(rgba(57,167,204,.72), rgba(20,98,145,.88)); transition: height .8s var(--ease), background .4s; }
    .water-layer::before { content: ""; position: absolute; left: -10%; top: -7px; width: 120%; height: 14px; opacity: .7; background: radial-gradient(ellipse at 50% 100%, transparent 48%, rgba(119,224,237,.8) 50% 58%, transparent 60%) 0 0 / 44px 14px repeat-x; animation: waterTop 3.5s linear infinite; }
    .scene-readout { position: absolute; z-index: 8; top: 18px; right: 18px; width: 124px; padding: 12px; border: 1px solid rgba(255,255,255,.12); border-radius: 14px; background: rgba(3,24,32,.7); backdrop-filter: blur(10px); }
    .scene-readout small { color: var(--muted); font-size: 8px; letter-spacing: .08em; text-transform: uppercase; }
