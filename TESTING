<?php
/**
 * AI Quiz Generation Platform - Single File PHP Implementation
 * Stores all data in JSON files instead of database
 */

// Enable JSON response
header('Content-Type: application/json');
header('Access-Control-Allow-Origin: *');
header('Access-Control-Allow-Methods: GET, POST, PUT, DELETE, OPTIONS');
header('Access-Control-Allow-Headers: Content-Type, Authorization');

if ($_SERVER['REQUEST_METHOD'] === 'OPTIONS') {
    http_response_code(200);
    exit;
}

// Configuration
$DB_DIR = __DIR__ . '/data';
$QUIZZES_FILE = $DB_DIR . '/quizzes.json';
$QUESTIONS_FILE = $DB_DIR . '/questions.json';
$SESSIONS_FILE = $DB_DIR . '/sessions.json';
$ATTEMPTS_FILE = $DB_DIR . '/attempts.json';

// Initialize database directory and files
function initDB() {
    global $DB_DIR, $QUIZZES_FILE, $QUESTIONS_FILE, $SESSIONS_FILE, $ATTEMPTS_FILE;
    
    if (!is_dir($DB_DIR)) {
        mkdir($DB_DIR, 0755, true);
    }
    
    $files = [
        $QUIZZES_FILE => ['nextId' => 1, 'items' => []],
        $QUESTIONS_FILE => ['nextId' => 1, 'items' => []],
        $SESSIONS_FILE => ['nextId' => 1, 'items' => []],
        $ATTEMPTS_FILE => ['nextId' => 1, 'items' => []],
    ];
    
    foreach ($files as $file => $default) {
        if (!file_exists($file)) {
            file_put_contents($file, json_encode($default, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES));
        }
    }
}

// Load JSON file
function loadJSON($file) {
    if (!file_exists($file)) {
        return ['nextId' => 1, 'items' => []];
    }
    $content = file_get_contents($file);
    return json_decode($content, true) ?: ['nextId' => 1, 'items' => []];
}

// Save JSON file
function saveJSON($file, $data) {
    file_put_contents($file, json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES));
}

// Generate quiz code
function makeCode() {
    $chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
    $code = '';
    for ($i = 0; $i < 6; $i++) {
        $code .= $chars[rand(0, strlen($chars) - 1)];
    }
    return $code;
}

// Generate unique code
function generateUniqueCode($quizzes) {
    for ($attempt = 0; $attempt < 5; $attempt++) {
        $code = makeCode();
        $exists = false;
        foreach ($quizzes as $quiz) {
            if ($quiz['code'] === $code) {
                $exists = true;
                break;
            }
        }
        if (!$exists) return $code;
    }
    return makeCode() . rand(10, 99);
}

// Generate session token
function newToken() {
    return bin2hex(random_bytes(20));
}

// Shuffle array
function shuffle_array($arr) {
    $keys = array_keys($arr);
    shuffle($keys);
    $result = [];
    foreach ($keys as $key) {
        $result[] = $arr[$key];
    }
    return $result;
}

// Sanitize quiz input
function sanitizeQuiz($input) {
    if (!is_array($input)) return null;
    
    $MAX_QUESTIONS = 25;
    $questions = [];
    
    if (isset($input['questions']) && is_array($input['questions'])) {
        foreach (array_slice($input['questions'], 0, $MAX_QUESTIONS) as $q) {
            if (!is_array($q)) continue;
            
            $prompt = trim($q['prompt'] ?? '');
            $options = [];
            
            if (isset($q['options']) && is_array($q['options'])) {
                foreach ($q['options'] as $opt) {
                    $opt_str = trim((string)$opt);
                    if ($opt_str !== '') {
                        $options[] = $opt_str;
                    }
                }
            }
            
            if (!$prompt || count($options) < 2) continue;
            
            $options = array_slice($options, 0, 4);
            $correctIndex = (int)($q['correctIndex'] ?? 0);
            
            if ($correctIndex < 0 || $correctIndex >= count($options)) {
                $correctIndex = 0;
            }
            
            $timeLimit = (int)($q['timeLimit'] ?? 30);
            $timeLimit = max(5, min(120, $timeLimit));
            
            $points = (int)($q['points'] ?? 1000);
            $points = max(100, min(2000, $points));
            
            $questions[] = [
                'prompt' => $prompt,
                'options' => $options,
                'correctIndex' => $correctIndex,
                'explanation' => trim($q['explanation'] ?? ''),
                'timeLimit' => $timeLimit,
                'points' => $points,
            ];
        }
    }
    
    if (empty($questions)) return null;
    
    $difficulty = strtolower($input['difficulty'] ?? 'medium');
    if ($difficulty !== 'easy' && $difficulty !== 'hard') {
        $difficulty = 'medium';
    }
    
    return [
        'title' => substr($input['title'] ?? 'Untitled Quiz', 0, 120) ?: 'Untitled Quiz',
        'description' => substr($input['description'] ?? '', 0, 400),
        'subject' => substr($input['subject'] ?? 'General', 0, 60) ?: 'General',
        'difficulty' => $difficulty,
        'coverEmoji' => substr($input['coverEmoji'] ?? '🧠', 0, 4) ?: '🧠',
        'questions' => $questions,
    ];
}

// Route handler
function handleRequest() {
    global $QUIZZES_FILE, $QUESTIONS_FILE, $SESSIONS_FILE, $ATTEMPTS_FILE;
    
    initDB();
    
    $method = $_SERVER['REQUEST_METHOD'];
    $path = parse_url($_SERVER['REQUEST_URI'], PHP_URL_PATH);
    $path = str_replace('/index.php', '', $path);
    $path = ltrim($path, '/');
    
    // Route: GET /api/quizzes
    if ($method === 'GET' && $path === 'api/quizzes') {
        $quizzes_data = loadJSON($QUIZZES_FILE);
        $questions_data = loadJSON($QUESTIONS_FILE);
        $attempts_data = loadJSON($ATTEMPTS_FILE);
        
        $result = [];
        foreach ($quizzes_data['items'] as $quiz) {
            $question_count = 0;
            $plays = 0;
            
            foreach ($questions_data['items'] as $q) {
                if ($q['quizId'] === $quiz['id']) $question_count++;
            }
            
            foreach ($attempts_data['items'] as $a) {
                if ($a['quizId'] === $quiz['id']) $plays++;
            }
            
            $result[] = [
                'id' => $quiz['id'],
                'code' => $quiz['code'],
                'title' => $quiz['title'],
                'description' => $quiz['description'],
                'subject' => $quiz['subject'],
                'difficulty' => $quiz['difficulty'],
                'author' => $quiz['author'],
                'coverEmoji' => $quiz['coverEmoji'],
                'proctored' => $quiz['proctored'],
                'createdAt' => $quiz['createdAt'],
                'questionCount' => $question_count,
                'plays' => $plays,
            ];
        }
        
        usort($result, function($a, $b) {
            return strtotime($b['createdAt']) - strtotime($a['createdAt']);
        });
        
        echo json_encode(['quizzes' => array_slice($result, 0, 60)]);
        return;
    }
    
    // Route: POST /api/quizzes
    if ($method === 'POST' && $path === 'api/quizzes') {
        $body = json_decode(file_get_contents('php://input'), true);
        $quiz_data = $body['quiz'] ?? $body;
        $draft = sanitizeQuiz($quiz_data);
        
        if (!$draft) {
            http_response_code(400);
            echo json_encode(['error' => 'Invalid quiz payload']);
            return;
        }
        
        $author = trim($body['author'] ?? 'Teacher');
        if (strlen($author) === 0) $author = 'Teacher';
        $author = substr($author, 0, 60);
        
        $quizzes_data = loadJSON($QUIZZES_FILE);
        $code = generateUniqueCode($quizzes_data['items']);
        
        $proctor = $body['proctor'] ?? [];
        $bool = function($v, $fallback) {
            return is_bool($v) ? $v : $fallback;
        };
        
        $created = [
            'id' => $quizzes_data['nextId'],
            'code' => $code,
            'title' => $draft['title'],
            'description' => $draft['description'],
            'subject' => $draft['subject'],
            'difficulty' => $draft['difficulty'],
            'author' => $author,
            'coverEmoji' => $draft['coverEmoji'],
            'shuffleQuestions' => $bool($proctor['shuffleQuestions'] ?? true, true),
            'shuffleOptions' => $bool($proctor['shuffleOptions'] ?? true, true),
            'proctored' => $bool($proctor['proctored'] ?? true, true),
            'requireFullscreen' => $bool($proctor['requireFullscreen'] ?? true, true),
            'blockCopy' => $bool($proctor['blockCopy'] ?? true, true),
            'maxViolations' => max(0, min(10, round($proctor['maxViolations'] ?? 3))),
            'createdAt' => date('c'),
        ];
        
        $quizzes_data['items'][] = $created;
        $quizzes_data['nextId']++;
        saveJSON($QUIZZES_FILE, $quizzes_data);
        
        // Save questions
        $questions_data = loadJSON($QUESTIONS_FILE);
        foreach ($draft['questions'] as $index => $q) {
            $questions_data['items'][] = [
                'id' => $questions_data['nextId'],
                'quizId' => $created['id'],
                'position' => $index,
                'prompt' => $q['prompt'],
                'options' => $q['options'],
                'correctIndex' => $q['correctIndex'],
                'explanation' => $q['explanation'],
                'timeLimit' => $q['timeLimit'],
                'points' => $q['points'],
            ];
            $questions_data['nextId']++;
        }
        saveJSON($QUESTIONS_FILE, $questions_data);
        
        http_response_code(201);
        echo json_encode(['quiz' => $created]);
        return;
    }
    
    // Route: GET /api/quizzes/:id
    if ($method === 'GET' && preg_match('/^api\/quizzes\/(\d+)$/', $path, $matches)) {
        $id = (int)$matches[1];
        $quizzes_data = loadJSON($QUIZZES_FILE);
        $questions_data = loadJSON($QUESTIONS_FILE);
        
        $quiz = null;
        foreach ($quizzes_data['items'] as $q) {
            if ($q['id'] === $id) {
                $quiz = $q;
                break;
            }
        }
        
        if (!$quiz) {
            http_response_code(404);
            echo json_encode(['error' => 'Quiz not found']);
            return;
        }
        
        $questions = [];
        foreach ($questions_data['items'] as $q) {
            if ($q['quizId'] === $id) {
                $questions[] = $q;
            }
        }
        
        usort($questions, function($a, $b) {
            return $a['position'] - $b['position'];
        });
        
        echo json_encode(['quiz' => $quiz, 'questions' => $questions]);
        return;
    }
    
    // Route: POST /api/play/start
    if ($method === 'POST' && $path === 'api/play/start') {
        $body = json_decode(file_get_contents('php://input'), true);
        $code = strtoupper(trim($body['code'] ?? ''));
        $player = trim($body['player'] ?? 'Anonymous');
        if (strlen($player) === 0) $player = 'Anonymous';
        $player = substr($player, 0, 24);
        
        if (!$code) {
            http_response_code(400);
            echo json_encode(['error' => 'code required']);
            return;
        }
        
        $quizzes_data = loadJSON($QUIZZES_FILE);
        $questions_data = loadJSON($QUESTIONS_FILE);
        
        $quiz = null;
        foreach ($quizzes_data['items'] as $q) {
            if ($q['code'] === $code) {
                $quiz = $q;
                break;
            }
        }
        
        if (!$quiz) {
            http_response_code(404);
            echo json_encode(['error' => 'Quiz not found']);
            return;
        }
        
        $items = [];
        foreach ($questions_data['items'] as $q) {
            if ($q['quizId'] === $quiz['id']) {
                $items[] = $q;
            }
        }
        
        usort($items, function($a, $b) {
            if ($a['position'] !== $b['position']) {
                return $a['position'] - $b['position'];
            }
            return $a['id'] - $b['id'];
        });
        
        if (empty($items)) {
            http_response_code(422);
            echo json_encode(['error' => 'Quiz has no questions']);
            return;
        }
        
        $ordered = $quiz['shuffleQuestions'] ? shuffle_array($items) : $items;
        
        $plan = [];
        foreach ($ordered as $q) {
            $opts = [];
            for ($i = 0; $i < count($q['options']); $i++) {
                $opts[] = $i;
            }
            if ($quiz['shuffleOptions']) {
                shuffle($opts);
            }
            $plan[] = [
                'qid' => $q['id'],
                'opts' => $opts,
            ];
        }
        
        $token = newToken();
        $sessions_data = loadJSON($SESSIONS_FILE);
        $sessions_data['items'][] = [
            'id' => $sessions_data['nextId'],
            'token' => $token,
            'quizId' => $quiz['id'],
            'player' => $player,
            'plan' => $plan,
            'cursor' => 0,
            'score' => 0,
            'correct' => 0,
            'streak' => 0,
            'violations' => 0,
            'events' => [],
            'status' => 'active',
            'servedAt' => date('c'),
            'startedAt' => date('c'),
        ];
        $sessions_data['nextId']++;
        saveJSON($SESSIONS_FILE, $sessions_data);
        
        $first = $ordered[0];
        $first_plan = $plan[0];
        
        echo json_encode([
            'token' => $token,
            'quiz' => [
                'id' => $quiz['id'],
                'code' => $quiz['code'],
                'title' => $quiz['title'],
                'description' => $quiz['description'],
                'subject' => $quiz['subject'],
                'difficulty' => $quiz['difficulty'],
                'coverEmoji' => $quiz['coverEmoji'],
                'proctored' => $quiz['proctored'],
                'requireFullscreen' => $quiz['requireFullscreen'],
                'blockCopy' => $quiz['blockCopy'],
                'maxViolations' => $quiz['maxViolations'],
            ],
            'total' => count($plan),
            'index' => 0,
            'question' => [
                'prompt' => $first['prompt'],
                'options' => array_map(function($idx) use ($first) {
                    return $first['options'][$idx];
                }, $first_plan['opts']),
                'timeLimit' => $first['timeLimit'],
                'points' => $first['points'],
            ],
        ]);
        return;
    }
    
    // Route: POST /api/play/answer
    if ($method === 'POST' && $path === 'api/play/answer') {
        $body = json_decode(file_get_contents('php://input'), true);
        $token = $body['token'] ?? '';
        $answer_index = (int)($body['answer'] ?? -1);
        
        $sessions_data = loadJSON($SESSIONS_FILE);
        $questions_data = loadJSON($QUESTIONS_FILE);
        
        $session = null;
        $session_idx = -1;
        foreach ($sessions_data['items'] as $idx => $s) {
            if ($s['token'] === $token) {
                $session = $s;
                $session_idx = $idx;
                break;
            }
        }
        
        if (!$session) {
            http_response_code(401);
            echo json_encode(['error' => 'Invalid token']);
            return;
        }
        
        if ($session['status'] !== 'active') {
            http_response_code(400);
            echo json_encode(['error' => 'Session not active']);
            return;
        }
        
        $plan_step = $session['plan'][$session['cursor']] ?? null;
        if (!$plan_step) {
            http_response_code(400);
            echo json_encode(['error' => 'Invalid cursor']);
            return;
        }
        
        $question = null;
        foreach ($questions_data['items'] as $q) {
            if ($q['id'] === $plan_step['qid']) {
                $question = $q;
                break;
            }
        }
        
        if (!$question) {
            http_response_code(404);
            echo json_encode(['error' => 'Question not found']);
            return;
        }
        
        $is_correct = false;
        $actual_index = -1;
        if ($answer_index >= 0 && $answer_index < count($plan_step['opts'])) {
            $actual_index = $plan_step['opts'][$answer_index];
            $is_correct = ($actual_index === $question['correctIndex']);
        }
        
        if ($is_correct) {
            $session['correct']++;
            $session['streak']++;
            $session['score'] += $question['points'];
        } else {
            $session['streak'] = 0;
        }
        
        $session['cursor']++;
        
        $next_index = $session['cursor'];
        $next_plan_step = $session['plan'][$next_index] ?? null;
        
        if ($next_plan_step) {
            $next_question = null;
            foreach ($questions_data['items'] as $q) {
                if ($q['id'] === $next_plan_step['qid']) {
                    $next_question = $q;
                    break;
                }
            }
            
            $result = [
                'correct' => $is_correct,
                'actualIndex' => $actual_index,
                'correctIndex' => $question['correctIndex'],
                'explanation' => $question['explanation'],
                'score' => $session['score'],
                'correct_count' => $session['correct'],
                'streak' => $session['streak'],
                'index' => $next_index,
                'total' => count($session['plan']),
                'question' => [
                    'prompt' => $next_question['prompt'],
                    'options' => array_map(function($idx) use ($next_question) {
                        return $next_question['options'][$idx];
                    }, $next_plan_step['opts']),
                    'timeLimit' => $next_question['timeLimit'],
                    'points' => $next_question['points'],
                ],
            ];
        } else {
            $session['status'] = 'finished';
            
            $attempts_data = loadJSON($ATTEMPTS_FILE);
            $attempts_data['items'][] = [
                'id' => $attempts_data['nextId'],
                'quizId' => $session['quizId'],
                'player' => $session['player'],
                'score' => $session['score'],
                'correct' => $session['correct'],
                'total' => count($session['plan']),
                'violations' => $session['violations'],
                'integrity' => 100,
                'flagged' => false,
                'status' => 'finished',
                'notes' => '',
                'createdAt' => date('c'),
            ];
            $attempts_data['nextId']++;
            saveJSON($ATTEMPTS_FILE, $attempts_data);
            
            $result = [
                'correct' => $is_correct,
                'actualIndex' => $actual_index,
                'correctIndex' => $question['correctIndex'],
                'explanation' => $question['explanation'],
                'score' => $session['score'],
                'correct_count' => $session['correct'],
                'streak' => $session['streak'],
                'index' => $next_index,
                'total' => count($session['plan']),
                'finished' => true,
            ];
        }
        
        $sessions_data['items'][$session_idx] = $session;
        saveJSON($SESSIONS_FILE, $sessions_data);
        
        echo json_encode($result);
        return;
    }
    
    // Route: GET /api/attempts
    if ($method === 'GET' && $path === 'api/attempts') {
        $quiz_id = isset($_GET['quizId']) ? (int)$_GET['quizId'] : null;
        
        $attempts_data = loadJSON($ATTEMPTS_FILE);
        
        $result = [];
        foreach ($attempts_data['items'] as $attempt) {
            if ($quiz_id === null || $attempt['quizId'] === $quiz_id) {
                $result[] = $attempt;
            }
        }
        
        usort($result, function($a, $b) {
            return strtotime($b['createdAt']) - strtotime($a['createdAt']);
        });
        
        echo json_encode(['attempts' => $result]);
        return;
    }
    
    // Route: GET /api/health
    if ($method === 'GET' && $path === 'api/health') {
        echo json_encode(['status' => 'ok', 'timestamp' => date('c')]);
        return;
    }
    
    // Default 404
    http_response_code(404);
    echo json_encode(['error' => 'Not found']);
}

handleRequest();
