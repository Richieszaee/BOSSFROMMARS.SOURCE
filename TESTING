    .principle-card::after { content: attr(data-word); position: absolute; right: -8px; bottom: -18px; color: rgba(255,255,255,.027); font-size: 62px; font-weight: 850; text-transform: uppercase; }

    /* Concepts */
    .concept-summary { display: flex; align-items: center; gap: 12px; }
    .concept-score { min-width: 89px; padding: 9px 12px; border: 1px solid rgba(99,230,210,.2); border-radius: 14px; color: var(--cyan); background: rgba(99,230,210,.055); text-align: center; }
    .concept-score b { display: block; font-size: 19px; }
    .concept-score small { color: var(--muted); font-size: 8px; }
    .concept-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; }
