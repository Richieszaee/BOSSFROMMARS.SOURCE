    .check-card { padding: 24px; }
    .check-card h3 { margin: 0 0 16px; font-size: 17px; }
    .check-list { display: grid; gap: 8px; }
    .check-item { display: grid; grid-template-columns: 28px 1fr auto; align-items: center; gap: 10px; padding: 10px; border: 1px solid var(--line); border-radius: 13px; background: rgba(255,255,255,.025); }
