    .source-no { width: 42px; height: 42px; display: grid; place-items: center; border-radius: 13px; color: var(--cyan); background: rgba(99,230,210,.08); font-size: 11px; font-weight: 850; }
    .source-card h3 { margin: 0 0 5px; color: var(--ink); font-size: 12px; }
    .source-card p { margin: 0; font-size: 8.5px; line-height: 1.45; }
