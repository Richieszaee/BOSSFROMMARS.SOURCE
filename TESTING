    .risk-result strong { display: block; margin-top: 5px; color: var(--coral); font-size: 18px; }
    .risk-equation-text { margin-top: 13px; color: var(--muted-2); font-size: 8px; line-height: 1.4; }
    .impact-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 11px; }
