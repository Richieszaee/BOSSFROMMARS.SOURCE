    .sim-caption { position: absolute; z-index: 8; left: 18px; bottom: 17px; max-width: 250px; color: rgba(230,250,248,.76); font-size: 9px; line-height: 1.45; }

    .control-card { padding: clamp(21px, 2.5vw, 30px); }
