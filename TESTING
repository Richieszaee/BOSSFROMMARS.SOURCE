<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>J.A.R.V.I.S. // Stark Industries 3D Neural OS & Puter.js</title>
  <!-- Puter.js v2 SDK -->
  <script src="https://js.puter.com/v2/"></script>
  <!-- Three.js -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <!-- Canvas Confetti -->
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.4/dist/confetti.browser.min.js"></script>

  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; -webkit-user-select: none; }
    body { background-color: #070913; color: #e2e8f0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; overflow: hidden; width: 100vw; height: 100vh; display: flex; flex-direction: column; }
    .cyber-grid { background-size: 36px 36px; background-image: linear-gradient(to right, rgba(0, 240, 255, 0.05) 1px, transparent 1px), linear-gradient(to bottom, rgba(0, 240, 255, 0.05) 1px, transparent 1px); }
    header { height: 60px; background: rgba(13, 19, 36, 0.85); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border-bottom: 1px solid rgba(0, 240, 255, 0.2); display: flex; align-items: center; justify-content: space-between; padding: 0 20px; z-index: 30; flex-shrink: 0; }
    .brand { display: flex; align-items: center; gap: 10px; }
    .brand-icon { width: 36px; height: 36px; border-radius: 10px; background: linear-gradient(135deg, rgba(0, 240, 255, 0.2), rgba(255, 215, 0, 0.2)); border: 1px solid rgba(0, 240, 255, 0.5); display: flex; align-items: center; justify-content: center; font-size: 18px; box-shadow: 0 0 15px rgba(0, 240, 255, 0.3); }
    .brand-title { font-weight: 800; font-size: 15px; letter-spacing: 1.5px; color: #fff; font-family: monospace, sans-serif; }
    .brand-title span { color: #00f0ff; }
    .pill-btn { background: rgba(15, 23, 42, 0.8); border: 1px solid rgba(0, 240, 255, 0.3); color: #38bdf8; padding: 6px 14px; border-radius: 12px; font-size: 12px; font-family: monospace; cursor: pointer; display: flex; align-items: center; gap: 6px; transition: all 0.2s ease; }
    .pill-btn:hover { background: rgba(0, 240, 255, 0.15); border-color: #00f0ff; box-shadow: 0 0 15px rgba(0, 240, 255, 0.3); }
    main { flex: 1; display: flex; overflow: hidden; position: relative; }
    .stage-container { flex: 1; position: relative; padding: 16px; display: flex; flex-direction: column; }
    .canvas-card { width: 100%; height: 100%; background: rgba(13, 19, 36, 0.7); backdrop-filter: blur(20px); border: 1px solid rgba(0, 240, 255, 0.25); border-radius: 24px; position: relative; overflow: hidden; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.6); }
    #three-canvas { width: 100%; height: 100%; display: block; cursor: grab; }
    #three-canvas:active { cursor: grabbing; }
    .hud-badge { position: absolute; top: 16px; left: 16px; background: rgba(10, 15, 30, 0.85); border: 1px solid rgba(0, 240, 255, 0.3); padding: 4px 10px; border-radius: 20px; font-size: 11px; font-family: monospace; color: #38bdf8; display: flex; align-items: center; gap: 6px; }
    .ping-dot { width: 6px; height: 6px; border-radius: 50%; background: #00f0ff; box-shadow: 0 0 8px #00f0ff; }
    .body-actions-bar { position: absolute; top: 16px; right: 16px; background: rgba(10, 15, 30, 0.85); border: 1px solid rgba(0, 240, 255, 0.3); padding: 4px; border-radius: 16px; display: flex; gap: 4px; z-index: 20; }
    .body-btn { background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); color: #cbd5e1; padding: 5px 10px; border-radius: 10px; font-size: 11px; font-family: monospace; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; gap: 4px; }
    .body-btn:hover { background: rgba(0, 240, 255, 0.2); border-color: #00f0ff; color: #00f0ff; }
    .voice-dock { position: absolute; bottom: 72px; left: 50%; transform: translateX(-50%); background: rgba(10, 15, 30, 0.9); border: 1px solid rgba(0, 240, 255, 0.3); padding: 8px 16px; border-radius: 30px; display: flex; align-items: center; gap: 12px; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5); z-index: 20; }
    #mic-canvas { width: 100px; height: 24px; border-radius: 6px; background: rgba(0, 0, 0, 0.4); }
    .mic-btn { width: 42px; height: 42px; border-radius: 50%; background: rgba(0, 240, 255, 0.15); border: 1px solid rgba(0, 240, 255, 0.4); color: #00f0ff; font-size: 18px; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.25s; }
    .mic-btn.active { background: #ff2a85; color: #fff; border-color: #ff2a85; box-shadow: 0 0 25px #ff2a85; animation: pulse 1.2s infinite; }
    @keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.1); } }
    .emote-deck { position: absolute; bottom: 16px; left: 50%; transform: translateX(-50%); background: rgba(10, 15, 30, 0.85); border: 1px solid rgba(255, 255, 255, 0.1); padding: 6px; border-radius: 20px; display: flex; gap: 6px; z-index: 20; }
    .emote-btn { background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); color: #cbd5e1; padding: 6px 12px; border-radius: 12px; font-size: 11px; font-family: monospace; cursor: pointer; display: flex; align-items: center; gap: 5px; transition: all 0.2s; }
    .emote-btn:hover { background: rgba(0, 240, 255, 0.2); border-color: #00f0ff; color: #00f0ff; }
    .chat-panel { width: 440px; height: 100%; padding: 16px 16px 16px 0; display: flex; flex-direction: column; }
    .chat-card { width: 100%; height: 100%; background: rgba(13, 19, 36, 0.8); backdrop-filter: blur(20px); border: 1px solid rgba(0, 240, 255, 0.2); border-radius: 24px; display: flex; flex-direction: column; overflow: hidden; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.6); }
    .chat-header { padding: 12px 18px; border-bottom: 1px solid rgba(0, 240, 255, 0.15); display: flex; align-items: center; justify-content: space-between; background: rgba(10, 15, 30, 0.6); }
    .model-badge { display: flex; align-items: gap 6px; font-size: 12px; font-family: monospace; color: #00f0ff; font-weight: bold; }
    .messages-container { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 12px; user-select: text; -webkit-user-select: text; }
    .msg { max-width: 88%; padding: 12px 16px; border-radius: 16px; font-size: 13px; line-height: 1.5; }
    .msg.user { align-self: flex-end; background: linear-gradient(135deg, #0284c7, #2563eb); color: #fff; border-bottom-right-radius: 4px; }
    .msg.assistant { align-self: flex-start; background: rgba(15, 23, 42, 0.85); border: 1px solid rgba(0, 240, 255, 0.2); color: #e2e8f0; border-bottom-left-radius: 4px; }
    .msg-author { font-size: 10px; font-family: monospace; color: #38bdf8; margin-bottom: 4px; font-weight: bold; }
    .chat-input-area { padding: 12px; border-top: 1px solid rgba(0, 240, 255, 0.15); background: rgba(10, 15, 30, 0.7); }
    .input-wrapper { display: flex; align-items: center; background: rgba(15, 23, 42, 0.9); border: 1px solid rgba(0, 240, 255, 0.25); border-radius: 16px; padding: 4px 8px; }
    .input-wrapper input { flex: 1; background: transparent; border: none; color: #fff; padding: 8px 10px; font-size: 13px; outline: none; }
    .send-btn { background: #00f0ff; border: none; color: #070913; padding: 8px 14px; border-radius: 12px; font-weight: bold; cursor: pointer; transition: all 0.2s; }
    .send-btn:hover { background: #38bdf8; box-shadow: 0 0 15px rgba(0, 240, 255, 0.5); }
  </style>
</head>
<body class="cyber-grid">
  <header>
    <div class="brand">
      <div class="brand-icon">🦾</div>
      <div class="brand-title">J.A.R.V.I.S. <span>//</span> STARK NEURAL OS</div>
    </div>
    <div class="header-actions">
      <button class="pill-btn" onclick="openModelPicker()">
        <span>⚡</span>
        <span id="header-model-name">Puter.js // DeepSeek V3</span>
      </button>
      <button class="pill-btn" onclick="triggerConfetti()">
        <span>🎉 Cheer</span>
      </button>
    </div>
  </header>

  <main>
    <div class="stage-container">
      <div class="canvas-card">
        <canvas id="three-canvas"></canvas>

        <div class="hud-badge">
          <div class="ping-dot"></div>
          <span id="hud-status">J.A.R.V.I.S. // STARK PROTOCOLS ONLINE</span>
        </div>

        <div class="body-actions-bar">
          <button class="body-btn" onclick="triggerAction('keyboard')">⌨️ Holo-Keys</button>
          <button class="body-btn" onclick="triggerAction('shield')">🛡️ Shield</button>
          <button class="body-btn" onclick="triggerAction('turbo')">⚡ Turbo Boost</button>
          <button class="body-btn" onclick="triggerAction('orbs')">🔮 Data Orbs</button>
        </div>

        <div class="voice-dock">
          <canvas id="mic-canvas" width="100" height="24"></canvas>
          <button class="mic-btn" id="mic-toggle-btn" onclick="toggleVoiceListening()">🎙️</button>
        </div>

        <div class="emote-deck">
          <button class="emote-btn" onclick="triggerAction('wave')">👋 Wave</button>
          <button class="emote-btn" onclick="triggerAction('dance')">💃 Dance</button>
          <button class="emote-btn" onclick="triggerAction('spin')">🌀 360 Spin</button>
          <button class="emote-btn" onclick="triggerAction('zen')">🧘 Zen Hover</button>
        </div>
      </div>
    </div>

    <div class="chat-panel">
      <div class="chat-card">
        <div class="chat-header">
          <div class="model-badge">
            <span class="ping-dot"></span>
            <span id="chat-model-label">puter.ai.chat // J.A.R.V.I.S. Active</span>
          </div>
        </div>

        <div class="messages-container" id="messages-list">
          <div class="msg assistant">
            <div class="msg-author">J.A.R.V.I.S. // STARK INDUSTRIES</div>
            <p>Good day, sir. J.A.R.V.I.S. online and operating at peak efficiency. All 3D telemetry, flight thrusters, and acoustic sensors are calibrated to your voice. How may I be of assistance today, sir?</p>
          </div>
        </div>

        <div class="chat-input-area">
          <form class="input-wrapper" onsubmit="handleChatSubmit(event)">
            <input type="text" id="chat-input" placeholder="Say 'deploy shield', 'type code', 'engage thrusters' or ask a question..." />
            <button type="submit" class="send-btn">Send</button>
          </form>
        </div>
      </div>
    </div>
  </main>

  <script>
    let scene, camera, renderer, characterGroup;
    let currentAvatar = 'nova';
    let currentAction = 'idle';
    let modelParts = {};
    let keyboardGroup, shieldMesh, orbsGroup, orbsList = [];
    let mouse = { x: 0, y: 0, targetX: 0, targetY: 0 };
    let clock = new THREE.Clock();
    let isSpeaking = false;
    let isListening = false;

    function initThreeScene() {
      const container = document.getElementById('three-canvas');
      scene = new THREE.Scene();
      camera = new THREE.PerspectiveCamera(45, container.clientWidth / container.clientHeight, 0.1, 100);
      camera.position.set(0, 1.2, 5.0);

      renderer = new THREE.WebGLRenderer({ canvas: container, antialias: true, alpha: true });
      renderer.setSize(container.parentElement.clientWidth, container.parentElement.clientHeight);

      const ambientLight = new THREE.AmbientLight(0x1a2238, 2.2);
      scene.add(ambientLight);

      const dirLight = new THREE.DirectionalLight(0x00f0ff, 2.8);
      dirLight.position.set(6, 9, 6);
      scene.add(dirLight);

      const grid = new THREE.GridHelper(24, 28, 0x00f0ff, 0x112244);
      grid.position.y = -1.9;
      grid.material.opacity = 0.45;
      grid.material.transparent = true;
      scene.add(grid);

      characterGroup = new THREE.Group();
      scene.add(characterGroup);

      keyboardGroup = new THREE.Group();
      keyboardGroup.position.set(0, 0.25, 0.75);
      keyboardGroup.rotation.x = -Math.PI / 6;
      keyboardGroup.add(new THREE.Mesh(new THREE.BoxGeometry(1.2, 0.04, 0.45), new THREE.MeshBasicMaterial({ color: 0x00f0ff, wireframe: true })));
      keyboardGroup.visible = false;
      scene.add(keyboardGroup);

      shieldMesh = new THREE.Mesh(
        new THREE.IcosahedronGeometry(1.8, 2),
        new THREE.MeshStandardMaterial({ color: 0x00f0ff, emissive: 0x0055ff, wireframe: true, transparent: true, opacity: 0.4 })
      );
      shieldMesh.position.set(0, 0.6, 0);
      shieldMesh.visible = false;
      scene.add(shieldMesh);

      orbsGroup = new THREE.Group();
      for (let i = 0; i < 3; i++) {
        const orb = new THREE.Mesh(new THREE.SphereGeometry(0.14, 16, 16), new THREE.MeshStandardMaterial({ color: 0xffd700, emissive: 0xffd700 }));
        orbsGroup.add(orb);
        orbsList.push(orb);
      }
      orbsGroup.visible = false;
      scene.add(orbsGroup);

      buildCharacter('nova');

      window.addEventListener('mousemove', (e) => {
        const rect = container.getBoundingClientRect();
        mouse.targetX = ((e.clientX - rect.left) / rect.width) * 2 - 1;
        mouse.targetY = -(((e.clientY - rect.top) / rect.height) * 2 - 1);
      });

      animate();
    }

    function buildCharacter(type) {
      while (characterGroup.children.length > 0) characterGroup.remove(characterGroup.children[0]);
      const metalMat = new THREE.MeshStandardMaterial({ color: 0x182033, metalness: 0.85, roughness: 0.2 });
      const glowMat = new THREE.MeshStandardMaterial({ color: 0x00f0ff, emissive: 0x00f0ff, emissiveIntensity: 1.2 });

      const head = new THREE.Group();
      head.position.set(0, 1.25, 0);
      head.add(new THREE.Mesh(new THREE.BoxGeometry(0.9, 0.8, 0.85), metalMat));

      const visor = new THREE.Mesh(new THREE.BoxGeometry(0.75, 0.35, 0.1), glowMat);
      visor.position.set(0, 0.05, 0.44);
      head.add(visor);
      characterGroup.add(head);

      const torso = new THREE.Group();
      torso.position.set(0, 0.4, 0);
      torso.add(new THREE.Mesh(new THREE.CylinderGeometry(0.55, 0.38, 0.75, 8), metalMat));

      const core = new THREE.Mesh(new THREE.IcosahedronGeometry(0.2, 1), glowMat);
      core.position.set(0, 0.08, 0.25);
      torso.add(core);

      const handL = new THREE.Mesh(new THREE.BoxGeometry(0.18, 0.25, 0.12), metalMat);
      handL.position.set(-0.9, 0, 0.2);
      torso.add(handL);

      const handR = new THREE.Mesh(new THREE.BoxGeometry(0.18, 0.25, 0.12), metalMat);
      handR.position.set(0.9, 0, 0.2);
      torso.add(handR);

      characterGroup.add(torso);
      modelParts = { head, torso, core, handL, handR };
    }

    function animate() {
      requestAnimationFrame(animate);
      const time = clock.getElapsedTime();
      const delta = clock.getDelta();

      mouse.x += (mouse.targetX - mouse.x) * 0.08;
      mouse.y += (mouse.targetY - mouse.y) * 0.08;

      const speedMult = currentAction === 'turbo' ? 2.5 : 1.0;
      characterGroup.position.set(
        Math.sin(time * 0.7 * speedMult) * (0.8 * speedMult),
        Math.sin(time * 1.5 * speedMult) * 0.35,
        Math.sin(time * 0.9 * speedMult) * 0.45
      );
      characterGroup.rotation.z = Math.cos(time * 0.7 * speedMult) * 0.2;

      if (modelParts.head) {
        modelParts.head.rotation.y = mouse.x * 0.6;
        modelParts.head.rotation.x = -mouse.y * 0.4;
      }

      keyboardGroup.visible = currentAction === 'keyboard';
      shieldMesh.visible = currentAction === 'shield';
      orbsGroup.visible = currentAction === 'orbs';

      if (shieldMesh.visible) shieldMesh.rotation.y += 0.02;
      if (orbsGroup.visible) {
        orbsList.forEach((orb, idx) => {
          const angle = time * 2.5 + (idx * Math.PI * 2) / 3;
          orb.position.set(Math.cos(angle) * 1.5, 0.8 + Math.sin(angle * 2) * 0.4, Math.sin(angle) * 1.5);
        });
      }

      if (currentAction === 'keyboard' && modelParts.handL && modelParts.handR) {
        modelParts.handL.position.set(-0.35 + Math.sin(time * 18) * 0.15, 0.25, 0.6);
        modelParts.handR.position.set(0.35 + Math.cos(time * 18) * 0.15, 0.25, 0.6);
      } else if (currentAction === 'wave' && modelParts.handR) {
        modelParts.handR.position.set(0.95, 0.8 + Math.sin(time * 14) * 0.2, 0.3);
      } else if (currentAction === 'dance') {
        characterGroup.position.y += Math.abs(Math.sin(time * 8)) * 0.3;
      }

      renderer.render(scene, camera);
    }

    function triggerAction(actionName) {
      currentAction = actionName;
      setTimeout(() => { if (currentAction === actionName) currentAction = 'idle'; }, 5000);
    }

    function triggerConfetti() {
      if (window.confetti) window.confetti({ particleCount: 70, spread: 80, origin: { y: 0.6 } });
      triggerAction('dance');
    }

    let recognition = null;
    function initVoice() {
      const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (SpeechRecognition) {
        recognition = new SpeechRecognition();
        recognition.continuous = true;
        recognition.interimResults = true;
        recognition.lang = 'en-US';
        recognition.onresult = (event) => {
          let final = '';
          for (let i = event.resultIndex; i < event.results.length; ++i) {
            if (event.results[i].isFinal) final += event.results[i][0].transcript;
          }
          if (final) handleSendMessage(final.trim());
        };
      }
    }

    function toggleVoiceListening() {
      isListening = !isListening;
      const btn = document.getElementById('mic-toggle-btn');
      if (isListening) {
        btn.classList.add('active');
        if (recognition) try { recognition.start(); } catch(e){}
      } else {
        btn.classList.remove('active');
        if (recognition) try { recognition.stop(); } catch(e){}
      }
    }

    async function handleSendMessage(text) {
      if (!text || !text.trim()) return;
      appendChatMessage('user', text);
      document.getElementById('chat-input').value = '';

      const lower = text.toLowerCase();
      if (lower.includes('shield') || lower.includes('protect')) triggerAction('shield');
      else if (lower.includes('keyboard') || lower.includes('type') || lower.includes('code')) triggerAction('keyboard');
      else if (lower.includes('turbo') || lower.includes('boost') || lower.includes('fly')) triggerAction('turbo');
      else if (lower.includes('wave') || lower.includes('hello')) triggerAction('wave');
      else if (lower.includes('dance')) triggerAction('dance');

      const assistantMsgElem = appendChatMessage('assistant', '...');

      try {
        if (window.puter && window.puter.ai) {
          const resp = await window.puter.ai.chat(
            `You are J.A.R.V.I.S., the polite and brilliant British AI assistant from Iron Man. Address the user as 'sir' and respond naturally and briskly: ${text}`,
            { model: 'deepseek/deepseek-chat' }
          );
          let reply = typeof resp === 'string' ? resp : resp?.message?.content || JSON.stringify(resp);
          assistantMsgElem.querySelector('p').innerText = reply;
          speakAsJarvis(reply);
        } else {
          setTimeout(() => {
            const reply = `Right away, sir. Executing your command for "${text}". All subroutines and flight systems are operating at peak efficiency.`;
            assistantMsgElem.querySelector('p').innerText = reply;
            speakAsJarvis(reply);
          }, 300);
        }
      } catch (e) {
        const reply = `Indeed, sir. Executing diagnostics for "${text}". J.A.R.V.I.S. neural telemetry is fully operational.`;
        assistantMsgElem.querySelector('p').innerText = reply;
        speakAsJarvis(reply);
      }
    }

    // J.A.R.V.I.S. Voice Synthesis with refined British cadence
    function speakAsJarvis(text) {
      if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel();
        const clean = text.replace(/```[\s\S]*?```/g, 'I have compiled the code on your screen, sir.')
                          .replace(/\[ACTION:[^\]]+\]/gi, '')
                          .replace(/[`*#_]/g, '')
                          .slice(0, 300);
        const utt = new SpeechSynthesisUtterance(clean);
        utt.rate = 1.16; // Sophisticated, fluid British speaking rate
        utt.pitch = 0.94; // Calm, deeper resonant tone

        const voices = window.speechSynthesis.getVoices();
        const jarvisVoice = voices.find(v => (v.lang === 'en-GB' || v.name.includes('UK') || v.name.includes('British') || v.name.includes('Daniel') || v.name.includes('Oliver') || v.name.includes('Arthur'))) || voices.find(v => v.lang.startsWith('en')) || voices[0];
        if (jarvisVoice) utt.voice = jarvisVoice;

        window.speechSynthesis.speak(utt);
      }
    }

    function appendChatMessage(role, content) {
      const container = document.getElementById('messages-list');
      const msg = document.createElement('div');
      msg.className = `msg ${role}`;
      const author = document.createElement('div');
      author.className = 'msg-author';
      author.innerText = role === 'user' ? 'SIR (VOICE / TEXT)' : 'J.A.R.V.I.S. // STARK INDUSTRIES';
      msg.appendChild(author);
      const p = document.createElement('p');
      p.innerText = content;
      msg.appendChild(p);
      container.appendChild(msg);
      container.scrollTop = container.scrollHeight;
      return msg;
    }

    function handleChatSubmit(e) {
      e.preventDefault();
      const input = document.getElementById('chat-input');
      handleSendMessage(input.value);
    }

    function openModelPicker() {
      const chosen = prompt(`Select Puter.js AI Model for J.A.R.V.I.S.:\n1. DeepSeek V3\n2. Claude 3.7 Sonnet\n3. GPT-4o Mini\n4. Mistral Large\n5. Llama 3.3`, 'DeepSeek V3');
      if (chosen) {
        document.getElementById('header-model-name').innerText = `Puter.js // ${chosen}`;
        document.getElementById('chat-model-label').innerText = `puter.ai.chat // ${chosen}`;
      }
    }

    window.addEventListener('DOMContentLoaded', () => {
      initThreeScene();
      initVoice();
    });
  </script>
</body>
</html>
