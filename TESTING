      transition: .2s;
    }
    .rail button:hover span { opacity: 1; transform: translate(0,-50%); }

    .bottombar {
      position: fixed;
      z-index: 30;
      inset: auto 0 0;
      height: var(--bottombar);
      display: grid;
      grid-template-columns: auto minmax(120px, 680px) auto;
      align-items: center;
      justify-content: center;
      gap: clamp(14px, 3vw, 30px);
      padding: 0 clamp(18px, 3vw, 44px);
      border-top: 1px solid var(--line);
      background: linear-gradient(to top, rgba(6,23,34,.95), rgba(6,23,34,.73));
      backdrop-filter: blur(16px);
    }
    .nav-btn {
      min-width: 102px;
      height: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 0 13px;
      border: 1px solid var(--line);
      border-radius: 12px;
      color: var(--muted);
      background: rgba(255,255,255,.035);
      font-size: 11px;
      font-weight: 720;
    }
    .nav-btn svg { width: 16px; height: 16px; }
    .nav-btn:hover:not(:disabled) { color: var(--ink); border-color: rgba(99,230,210,.28); background: rgba(99,230,210,.07); }
    .nav-btn:disabled { opacity: .32; cursor: not-allowed; }
    .progress-zone { min-width: 0; }
    .progress-meta { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 6px; color: var(--muted-2); font-size: 8px; text-transform: uppercase; letter-spacing: .1em; }
    .progress-meta strong { overflow: hidden; color: var(--muted); text-overflow: ellipsis; white-space: nowrap; font-size: 8px; }
    .progress-track { position: relative; height: 3px; border-radius: 99px; background: rgba(255,255,255,.07); }
    .progress-fill { position: absolute; inset: 0 auto 0 0; width: 0; border-radius: inherit; background: linear-gradient(90deg, var(--cyan), var(--blue)); transition: width .55s var(--ease); box-shadow: 0 0 15px rgba(99,230,210,.26); }

    /* Narration */
    .narration-panel {
      position: fixed;
      z-index: 50;
      left: 50%;
      bottom: calc(var(--bottombar) + 15px);
      width: min(760px, calc(100% - 34px));
      padding: 15px 17px;
      border: 1px solid rgba(99,230,210,.2);
      border-radius: 17px;
      background: rgba(7,35,45,.94);
      backdrop-filter: blur(18px);
      box-shadow: var(--shadow);
      opacity: 0;
      transform: translate(-50%, 12px);
      visibility: hidden;
      transition: .3s var(--ease);
    }
    .narration-panel.is-visible { opacity: 1; transform: translate(-50%,0); visibility: visible; }
    .narration-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 7px; }
    .narration-state { display: flex; align-items: center; gap: 8px; color: var(--cyan); font-size: 9px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
    .voice-bars { display: flex; align-items: end; gap: 2px; height: 11px; }
    .voice-bars i { width: 2px; height: 5px; border-radius: 2px; background: var(--cyan); animation: voiceBar .65s ease-in-out infinite alternate; }
    .voice-bars i:nth-child(2) { animation-delay: -.22s; }
    .voice-bars i:nth-child(3) { animation-delay: -.42s; }
    .narration-panel:not(.is-speaking) .voice-bars i { animation-play-state: paused; height: 3px; }
    .narration-close { border: 0; color: var(--muted); background: transparent; cursor: pointer; font-size: 17px; }
    .narration-text { margin: 0; max-height: 92px; overflow: auto; color: #c4dada; font-size: 11px; line-height: 1.58; }

    .toast {
      position: fixed;
      z-index: 80;
      left: 50%;
      top: calc(var(--topbar) + 14px);
      max-width: calc(100% - 30px);
      padding: 9px 13px;
      border: 1px solid var(--line);
      border-radius: 11px;
